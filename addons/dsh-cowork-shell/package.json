{
  "name": "@local/dsh-cowork-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The left panel: five space buttons (Chat, Code, Devices, Recon, Workshop) at the top, each with its own threads, a New button, your projects and Settings. Replaces the app's own sidebar while it is on; removing it brings the app's sidebar back.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "lib/*.js",
    "presets/*.md", "cordis.patch.yml", "README.md", "locale/*.json", "icon.svg", "node_modules/@deepseek-ai/schemastery/**", "node_modules/@deepseek-ai/cosmokit/**"],
  "engines": { "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
