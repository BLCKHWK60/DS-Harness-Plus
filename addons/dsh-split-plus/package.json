{
  "name": "@local/dsh-split-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental: A Split page: two to four conversations side by side in one window, each in any mode with its own controls and permission mode, sharing one folder. Off until you switch it on.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "passport/**",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "node_modules/@deepseek-ai/schemastery/**",
    "node_modules/@deepseek-ai/cosmokit/**"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
