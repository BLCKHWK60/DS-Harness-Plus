{
  "name": "@local/dsh-role-prompts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adds your own instruction sections (for example planning, coding, routing) to the system prompt, optionally per tier. Has a page, shown as a tab of the Model tiers page.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "examples/*.txt",
    "locale/*.json",
    "icon.svg",
    "node_modules/@deepseek-ai/schemastery/**",
    "node_modules/@deepseek-ai/cosmokit/**"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
