{
  "name": "@local/dsh-role-prompts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adds your own instruction sections (for example planning, coding, routing) to the system prompt, optionally per tier.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "examples/*.txt",
    "locale/*.json",
    "icon.svg",
    "node_modules/@deepseek-ai/schemastery/**",
    "node_modules/@deepseek-ai/cosmokit/**"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
