{
  "name": "@local/dsh-tuning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tuning Plus: keeps every checked step of your work as a training row with its proof, builds named data sets and a private exam from them, and turns them into better instructions, adapters and small tuned models on this Mac, each tested on the exam before you are asked. Off until you switch it on.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "lib/*.py",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "node_modules/@deepseek-ai/schemastery/**",
    "node_modules/@deepseek-ai/cosmokit/**"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
